# Hosted Envoy node: TRP-only, SQLite on the container's local disk, replicated to an
# S3-compatible bucket with Litestream.
#
# Native (non cross-compiled) build, like the Dockerfile.trponly that the demo's
# scripts/patch-envoy.py generates — the cross-compilation toolchain buys nothing when
# the image is built on the machine it runs on.
#
# The difference from Dockerfile.trponly is the runtime: Litestream restores
# /data/trisa.db from the replica before Envoy starts and supervises Envoy while it
# streams the WAL back out. /data is a plain directory, NOT a VOLUME: on Cloudflare
# Containers the disk is ephemeral and the replica is the only durable copy. A VPS can
# bind-mount a volume over /data and the same image skips the restore.
#
#   docker build -f Dockerfile.hosted --build-arg VERSION=hosted-$(git rev-parse --short=7 HEAD) -t trisa/envoy:hosted .
#
# See docker/hosted/README.md for the environment and the fail-closed rules.

FROM golang:1.26-bookworm AS builder

ARG VERSION=hosted

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV CGO_ENABLED=1
RUN go build -ldflags="-X 'github.com/trisacrypto/envoy/pkg.GitVersion=${VERSION}'" \
    -o /go/bin/envoy ./cmd/envoy

FROM debian:bookworm-slim AS final

LABEL description="TRISA Envoy node, TRP-only, SQLite replicated with Litestream"

# curl is not a debugging convenience: the entrypoint's bootstrap callback uses it to
# hand the node's first API key back to whatever provisioned it, because a hosted
# container has no `docker exec`, and the storage-credentials helper uses it to fetch
# the node's R2 credentials from the Worker. See docker/hosted/README.md.
RUN set -x && apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates sqlite3 curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /go/bin/envoy /usr/local/bin/envoy
COPY --from=litestream/litestream:0.3.13 /usr/local/bin/litestream /usr/local/bin/litestream

COPY docker/hosted/litestream.yml /etc/litestream.yml
COPY docker/hosted/entrypoint.sh /usr/local/bin/hosted-entrypoint.sh

# Process-mode storage credentials: the SDK inside Litestream runs the helper named in
# /etc/aws/config and runs it again when the credentials it returned expire, so the
# Worker can rotate them without a restart. The entrypoint turns these two variables
# off again in static mode (AWS_* or LITESTREAM_* keys in the environment). See
# docker/hosted/README.md.
COPY docker/hosted/storage-credentials.sh /usr/local/bin/storage-credentials
COPY docker/hosted/aws-config /etc/aws/config

ENV AWS_CONFIG_FILE=/etc/aws/config
ENV AWS_SDK_LOAD_CONFIG=1

RUN chmod 0755 /usr/local/bin/hosted-entrypoint.sh /usr/local/bin/storage-credentials && \
    chmod 0644 /etc/aws/config && \
    mkdir -p /data /run/node && chmod 0700 /run/node

# Declarative only under Docker and on Cloudflare Containers in production, but
# `wrangler dev` reads the image's exposed ports to decide what to map locally, so
# without these two lines the local container is unreachable from the Worker.
# https://developers.cloudflare.com/containers/local-dev/
EXPOSE 8000 8200

ENTRYPOINT [ "/usr/local/bin/hosted-entrypoint.sh" ]
